    </mxCell>
    <mxCell id="r3-gcp" value="Google-managed by default;&#xa;optional CMEK via dynamic&#xa;encryption block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="400" y="222" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r3-az" value="Microsoft-managed by default;&#xa;inherited at Storage Account level&#xa;across all containers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
