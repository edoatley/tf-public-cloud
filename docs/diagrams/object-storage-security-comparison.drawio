    </mxCell>

    <mxCell id="r3-feat" value="Encryption at Rest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#333333;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
