    <mxCell id="r1-feat" value="Public Access Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#333333;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="10" y="102" width="170" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r1-aws" value="Public Access Block (4 flags);&#xa;must be set explicitly — not on&#xa;by default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="180" y="102" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r1-gcp" value="public_access_prevention =&#xa;&quot;enforced&quot; — hard guardrail even&#xa;if IAM is later misconfigured" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="400" y="102" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r1-az" value="allow_nested_items_to_be_public&#xa;= false on Storage Account;&#xa;container_access_type = private" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="620" y="102" width="220" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="r2-feat" value="HTTPS Enforcement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#333333;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="10" y="162" width="170" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r2-aws" value="Bucket policy required: Deny&#xa;where aws:SecureTransport = false;&#xa;not enforced by default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="180" y="162" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r2-gcp" value="Inherent — GCS has no HTTP&#xa;endpoint; no configuration needed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="400" y="162" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r2-az" value="https_traffic_only_enabled = true&#xa;+ min_tls_version = TLS1_2 on&#xa;Storage Account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;fontColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
